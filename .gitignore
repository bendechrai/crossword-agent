node_modules/
dist/
coverage/
runs/
logs/
cache/
corpora/
data/
# test fixtures live under cache/ and runs/ but must not be swallowed by the bare patterns above
!test/fixtures/cache
!test/fixtures/cache/**
!test/fixtures/runs
!test/fixtures/runs/**

# Fetched puzzles are never committed (B46); the fixtures are.
puzzles/**
# git cannot re-include files under an excluded directory unless the directory itself is re-included first
!puzzles/fixtures
!puzzles/fixtures/**

.env
.env.*
!.env.example

.claude/worktrees/
# agent worktrees and local settings
.claude/
